# Copy this file to .env and fill in the blank values. Never commit .env.
#
# 1) Choose four database passwords. Use letters and digits only (they are placed inside URLs).
#    To generate one:  node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# 2) Connection strings used by the web app. They reuse the app passwords above; do not edit.
DATABASE_URL=postgresql://sapeis_app:${APP_DB_PASSWORD}@localhost:5432/sapeis
MONGODB_URI=mongodb://sapeis_app:${MONGO_APP_PASSWORD}@localhost:27017/sapeis
MONGODB_DB=sapeis

# 3) Signs login sessions (at least 32 characters).
#    Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
